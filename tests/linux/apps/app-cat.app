{
  "description": "cat(1) concatenates two files to stdout",
  "steps": [
    [
      "cat",
      "a.txt",
      "b.txt"
    ]
  ],
  "files": [
    {
      "path": "a.txt",
      "text": "first line\nsecond line\n"
    },
    {
      "path": "b.txt",
      "text": "third line, no newline"
    }
  ]
}
